# Environnement : local | production
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8888/site-candi

# Base de données MySQL
DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=site_candi
DB_USER=root
DB_PASS=root
DB_CHARSET=utf8mb4

# Sécurité des sessions
SESSION_SECRET=changez-ce-secret-session-32-caracteres

# Paiement CinetPay (stocké aussi dans payment_gateway_settings)
# Laissez vide si géré uniquement via l'UI admin
CINETPAY_SITE_ID=
CINETPAY_API_KEY=
CINETPAY_ENV=sandbox

# SMS Nimba (stocké aussi dans payment_gateway_settings)
NIMBA_API_KEY=
NIMBA_SENDER=CaNDI

# Email SMTP (optionnel)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=info@candi-group.com
MAIL_FROM_NAME=CaNDI
